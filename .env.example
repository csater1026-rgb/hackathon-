# Copy this file to .env.local for local dev, or set these in Vercel's
# Project Settings -> Environment Variables for the live demo.
#
# Leave AI_API_KEY unset to run in scripted "demo mode" (the live link still
# works, it just uses sample replies). Set it to switch on the real AI teacher.

# Your model provider API key. Works with Featherless AI (the sponsor) or any
# OpenAI-compatible provider.
AI_API_KEY=

# The provider's OpenAI-compatible base URL.
# Featherless (default): https://api.featherless.ai/v1
# OpenAI:                 https://api.openai.com/v1
AI_BASE_URL=https://api.featherless.ai/v1

# The model to teach with. Any chat model your provider offers.
AI_MODEL=mistralai/Mistral-Nemo-Instruct-2407
