# Copy this file to .env.local for local dev, or set these in Vercel's
# Project Settings -> Environment Variables for the live demo.
#
# Leave AI_API_KEY unset to run in scripted "demo mode" (the live link still
# works, it just uses sample replies). Set it to switch on the real AI teacher.

# Your model provider API key.
# For Google Gemini (the default): get a free key at https://aistudio.google.com/apikey
AI_API_KEY=

# The provider's OpenAI-compatible base URL.
# Gemini (default): https://generativelanguage.googleapis.com/v1beta/openai
# Featherless:      https://api.featherless.ai/v1
# OpenAI:           https://api.openai.com/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# The model to teach with.
# Gemini:      gemini-2.0-flash   (or gemini-2.5-flash, gemini-1.5-flash)
# Featherless: mistralai/Mistral-Nemo-Instruct-2407
AI_MODEL=gemini-2.0-flash
